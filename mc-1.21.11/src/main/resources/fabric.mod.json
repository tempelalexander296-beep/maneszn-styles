{
  "schemaVersion": 1,
  "id": "maneszn_styles",
  "version": "${version}",
  "name": "Maneszn Styles",
  "description": "All-in-One-Mod für Texturen und Cosmetics: eingebaute Styles pro Item und Block, eigene Bilder importieren, Presets – jetzt mit dem Christmas Advent Calendar (24 exklusive 3D-Cosmetics).",
  "authors": ["Maneszn"],
  "contact": { "homepage": "https://maneszn-api.onrender.com" },
  "license": "All-Rights-Reserved",
  "icon": "assets/maneszn_styles/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.maneszn.advent.AdventMod"],
    "client": ["com.maneszn.styles.ManesznStyles", "dev.maneszn.advent.client.AdventClient"]
  },
  "mixins": [
    { "config": "maneszn_styles.mixins.json", "environment": "client" },
    { "config": "maneszn_styles.optional.mixins.json", "environment": "client" }
  ],
  "provides": ["adventcosmetics"],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
